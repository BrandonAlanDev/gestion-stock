generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// --- Autenticación ---

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  telefono      String?
  account       account[]
}

enum user_role {
  USER
  ADMIN
}

// --- Lógica de Negocio ---

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  garments    Garment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Provider {
  id          String    @id @default(cuid())
  name        String    @unique
  contactInfo String?
  active      Boolean   @default(true)
  // Un proveedor puede tener muchas prendas (1:N)
  garments    Garment[] 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Garment {
  id          String     @id @default(cuid())
  sku         String?    @unique
  name        String
  price       Decimal    @db.Decimal(10, 2)
  stock       Int        @default(0)
  description String?
  active      Boolean    @default(true)
  
  // Relación con Categoría
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  
  // Relación con Proveedor (Muchos productos a un mismo proveedor)
  // Se usa 'supplier' como nombre de relación para evitar conflictos con la palabra 'provider'
  supplierId  String?
  supplier    Provider?  @relation(fields: [supplierId], references: [id])
  
  movements   Movement[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId])
  @@index([supplierId])
}

enum MovementType {
  IN
  OUT
}

model Movement {
  id          String       @id @default(cuid())
  type        MovementType
  quantity    Int
  priceAtTime Decimal      @db.Decimal(10, 2)
  note        String?
  
  garmentId   String
  garment     Garment      @relation(fields: [garmentId], references: [id], onDelete: Cascade) 
  
  createdAt   DateTime     @default(now())

  @@index([garmentId])
}