generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?
  telefono      String?
  account       account[]
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  garments      Garment[]
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  active     Boolean   @default(true)
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sizeTypeId String?
  category   Category  @relation(fields: [categoryId], references: [id])
  sizeType   SizeType? @relation(fields: [sizeTypeId], references: [id])
  garments   Garment[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([sizeTypeId])
}

model Garment {
  id            String           @id @default(cuid())
  name          String
  price         Decimal          @db.Decimal(10, 2)
  description   String?          @db.Text
  active        Boolean          @default(true)
  categoryId    String
  supplierId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cost          Decimal          @db.Decimal(10, 2)
  subCategoryId String?
  maxPrice      Decimal?         @db.Decimal(10, 2)
  category      Category         @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  supplier      Provider?        @relation(fields: [supplierId], references: [id])
  variants      GarmentVariant[]
  images        GarmentImage[]

  @@index([categoryId])
  @@index([categoryId, createdAt])
  @@index([subCategoryId, createdAt])
  @@index([subCategoryId])
  @@index([supplierId])
}

model GarmentImage {
  id        String  @id @default(cuid())
  srcImage  String  @db.Text
  publicId  String? @db.Text
  alt       String?
  order     Int     @default(0)
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
}

model GarmentVariant {
  id         String     @id @default(cuid())
  sku        String?    @unique
  stock      Int        @default(0)
  garmentId  String
  sizeId     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  colorId    String?
  attributes Json?
  garment    Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size       Size?      @relation(fields: [sizeId], references: [id])
  color      Color?     @relation(fields: [colorId], references: [id])
  movements  Movement[]

  @@unique([garmentId, sizeId, colorId])
  @@index([garmentId])
  @@index([sizeId])
  @@index([colorId])
}

model SizeType {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  sizes         Size[]
  subCategories SubCategory[]
}

model Size {
  id         String           @id @default(cuid())
  active     Boolean          @default(true)
  order      Int              @default(0)
  sizeTypeId String
  value      String
  sizeType   SizeType         @relation(fields: [sizeTypeId], references: [id])
  variants   GarmentVariant[]

  @@unique([value, sizeTypeId])
  @@index([sizeTypeId])
}

model Color {
  id       String           @id @default(cuid())
  name     String           @unique
  hex      String?
  active   Boolean          @default(true)
  variants GarmentVariant[]
}

model Provider {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  details   String?
  contacts  ContactProvider[]
  garments  Garment[]
}

model ContactProvider {
  id         String   @id @default(cuid())
  contact    String
  type       String
  idProvider String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   Provider @relation(fields: [idProvider], references: [id], onDelete: Cascade)

  @@unique([contact, idProvider])
  @@index([idProvider])
}

model Movement {
  id             String         @id @default(cuid())
  type           MovementType
  quantity       Int
  priceAtTime    Decimal        @db.Decimal(10, 2)
  note           String?
  variantId      String
  createdAt      DateTime       @default(now())
  garmentVariant GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([type, createdAt])
}

model PageConfig {
  id                   Int                       @id @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  storeName            String
  description          String?                   @db.Text
  slogan               String?
  logo                 String?                   @db.Text
  favicon              String?                   @db.Text
  primaryColor         String?                   @default("#06b6d4")
  secondaryColor       String?                   @default("#FFFFFF")
  bgColor              String?                   @default("#09090b")
  ecommerceEnabled     Boolean                   @default(true)
  cartEnabled          Boolean                   @default(true)
  checkoutEnabled      Boolean                   @default(true)
  phone                String?
  whatsapp             String?
  email                String?
  locationEnabled      Boolean                   @default(false)
  address              String?
  city                 String?
  province             String?
  country              String?
  postalCode           String?
  mapsUrl              String?                   @db.Text
  instagram            String?                   @db.Text
  facebook             String?                   @db.Text
  tiktok               String?                   @db.Text
  x                    String?                   @db.Text
  youtube              String?                   @db.Text
  linkedin             String?                   @db.Text
  currency             String                    @default("ARS")
  language             String                    @default("es")
  maintenanceMode      Boolean                   @default(false)
  metaTitle            String?
  metaDescription      String?                   @db.Text
  termsAndConditions   String?                   @db.Text
  privacyPolicy        String?                   @db.Text
  featuredLayout       PageConfig_featuredLayout @default(GRID)
  homegridId           String?
  arreglosEnabled      Boolean                   @default(false)
  escuelaEnabled       Boolean                   @default(false)
  personalizadoEnabled Boolean                   @default(false)
  planAhorroEnabled    Boolean                   @default(false)
  footerAboutText      String?                   @db.Text
  footerCopyrightText  String?
  footerShowSobre      Boolean                   @default(true)
  footerShowNavegacion Boolean                   @default(true)
  footerShowContacto   Boolean                   @default(true)
  footerShowUbicacion  Boolean                   @default(true)
  footerShowRedes      Boolean                   @default(true)
  footerShowLegales    Boolean                   @default(true)
  sectionOrder         String                    @default("[\"hero\",\"banner\",\"featured\",\"cards\",\"location\"]")
  fontPrimary          String                    @default("Outfit")
  fontSecondary        String                    @default("Playfair Display")
  borderRadius         String                    @default("redondeado")
  shadowLevel          String                    @default("sutil")
  density              String                    @default("comoda")
  banners              Banner[]
  carousels            Carousel[]
  homegrid             Homegrid?                 @relation(fields: [homegridId], references: [id])
}

model Banner {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order        Int
  image        String?    @db.Text
  title        String?
  subtitle     String?
  text         String?    @db.Text
  url          String?    @db.Text
  pageConfigId Int
  pageConfig   PageConfig @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  @@unique([pageConfigId, order])
}

model CustomBoard {
  id             String   @id @default(cuid())
  tipo           String
  largo          String
  ancho          String
  espesor        String
  volumen        String?
  material       String
  cola           String
  killaTipo      String
  killaCount     String
  notas          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deliveryOption String?
}

model BoardTypeOption {
  id             String                 @id @default(cuid())
  name           String                 @unique
  svgPath        String?                @db.Text
  active         Boolean                @default(true)
  allowedTails   BoardTailOption[]
  allowedFins    BoardFinOption[]
  allowedConfigs BoardFinConfigOption[]
}

model BoardMaterialOption {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
}

model BoardTailOption {
  id         String            @id @default(cuid())
  name       String            @unique
  svgPath    String?           @db.Text
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardFinOption {
  id         String            @id @default(cuid())
  name       String            @unique
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardDeliveryOption {
  id          String   @id @default(cuid())
  label       String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BoardFinConfigOption {
  id         String            @id @default(cuid())
  name       String            @unique
  count      Int
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardFinConfigOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardFinConfigOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardFinConfigOptionToBoardTypeOption_B_index")
  @@map("_BoardFinConfigOptionToBoardTypeOption")
}

model BoardFinOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardFinOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardFinOptionToBoardTypeOption_B_index")
  @@map("_BoardFinOptionToBoardTypeOption")
}

model BoardTailOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardTailOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardTailOptionToBoardTypeOption_B_index")
  @@map("_BoardTailOptionToBoardTypeOption")
}

model CustomPage {
  id        String          @id @default(cuid())
  slug      String          @unique
  title     String
  subtitle  String?         @db.Text
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  CustomSection[]

  @@map("CustomPages")
}

model CustomSection {
  id       String              @id @default(cuid())
  pageId   String
  type     SectionType
  title    String?
  subtitle String?             @db.Text
  order    Int                 @default(0)
  config   Json?
  page     CustomPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items    CustomSectionItem[]

  @@index([pageId])
  @@map("CustomPageSections")
}

model CustomSectionItem {
  id          String        @id @default(cuid())
  sectionId   String
  title       String
  description String?       @db.Text
  image       String?
  icon        String?
  link        String?
  order       Int           @default(0)
  config      Json?
  section     CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("CustomPageItems")
}

model Homegrid {
  id          String       @id @default(cuid())
  title       String
  subtitle    String
  style       Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  columns     String       @default("md:grid-cols-2")
  grids       Grid[]
  pageConfigs PageConfig[]
}

model Grid {
  id              String        @id @default(cuid())
  title           String
  subtitle        String
  image           String
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  homegridId      String
  linkType        GridLinkType  @default(NONE)
  linkValue       String?
  subtitleNeon    Boolean       @default(false)
  subtitleDim     Boolean       @default(false)
  linkStyle       LinkStyle     @default(IMAGE)
  buttonVariant   ButtonVariant @default(DEFAULT)
  buttonText      String?
  buttonBgColor   String?
  buttonTextColor String?
  homegrid        Homegrid      @relation(fields: [homegridId], references: [id], onDelete: Cascade)

  @@index([homegridId])
}

enum LinkStyle {
  IMAGE
  BUTTON
}

enum ButtonVariant {
  DEFAULT
  STRAIGHT
  TRANSPARENT
}

enum GridLinkType {
  NONE
  CATEGORY
  PRODUCT
  PAGE
  EXTERNAL
}

enum user_role {
  USER
  ADMIN
}

enum MovementType {
  IN
  OUT
}

enum SectionType {
  HERO
  TEXT
  CARDS
  FAQ
  TIMELINE
  CTA
  GALLERY
  FEATURES
}

enum PageConfig_featuredLayout {
  GRID
  COLLAGE
  MINIMAL
}

enum CarouselType {
  HERO // Carrusel fullscreen estilo Hero, con variante DEFAULT o SHOWCASE (ver settings.heroStyle)
  BANNER // Franja horizontal rotativa (solo debajo del Hero)
  CARDS // Grilla de tarjetas (nueva, paralela a FeaturedSection)
}

model Carousel {
  id           String       @id @default(cuid())
  type         CarouselType
  title        String? // Título de la sección (solo para CARDS/BANNER)
  active       Boolean      @default(true)
  order        Int          @default(0) // Orden global en la home
  pageConfigId Int
  pageConfig   PageConfig   @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  settings Json? // Config específica por tipo (ver abajo)
  slides   CarouselSlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageConfigId, order])
}

model CarouselSlide {
  id         String   @id @default(cuid())
  carouselId String
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)

  order       Int
  image       String? @db.Text
  publicId    String? @db.Text
  title       String?
  subtitle    String?
  description String? @db.Text
  ctaText     String? // Texto del botón (NUEVO vs Banner actual)
  url         String? @db.Text

  // Config por slide (para Hero: layout "standard" | "split" | "minimal")
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carouselId, order])
}
