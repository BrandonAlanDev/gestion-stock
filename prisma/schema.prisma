generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?
  telefono      String?
  account       account[]
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  garments      Garment[]
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  active     Boolean   @default(true)
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sizeTypeId String?
  category   Category  @relation(fields: [categoryId], references: [id])
  sizeType   SizeType? @relation(fields: [sizeTypeId], references: [id])
  garments   Garment[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([sizeTypeId])
}

model Garment {
  id            String           @id @default(cuid())
  name          String
  price         Decimal          @db.Decimal(10, 2)
  description   String?          @db.Text
  active        Boolean          @default(true)
  categoryId    String
  supplierId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cost          Decimal          @db.Decimal(10, 2)
  subCategoryId String?
  maxPrice      Decimal?         @db.Decimal(10, 2)
  category      Category         @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  supplier      Provider?        @relation(fields: [supplierId], references: [id])
  variants      GarmentVariant[]
  images        GarmentImage[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([supplierId])
}

model GarmentImage {
  id        String  @id @default(cuid())
  srcImage  String  @db.Text
  alt       String?
  order     Int     @default(0)
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
}

model GarmentVariant {
  id         String     @id @default(cuid())
  sku        String?    @unique
  stock      Int        @default(0)
  garmentId  String
  sizeId     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  colorId    String?
  attributes Json?
  garment    Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size       Size?      @relation(fields: [sizeId], references: [id])
  color      Color?     @relation(fields: [colorId], references: [id])
  movements  Movement[]

  @@unique([garmentId, sizeId, colorId])
  @@index([garmentId])
  @@index([sizeId])
  @@index([colorId])
}

model SizeType {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  sizes         Size[]
  subCategories SubCategory[]
}

model Size {
  id         String           @id @default(cuid())
  active     Boolean          @default(true)
  order      Int              @default(0)
  sizeTypeId String
  value      String
  sizeType   SizeType         @relation(fields: [sizeTypeId], references: [id])
  variants   GarmentVariant[]

  @@unique([value, sizeTypeId])
  @@index([sizeTypeId])
}

model Color {
  id       String           @id @default(cuid())
  name     String           @unique
  hex      String?
  active   Boolean          @default(true)
  variants GarmentVariant[]
}

model Provider {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  details   String?
  contacts  ContactProvider[]
  garments  Garment[]
}

model ContactProvider {
  id         String   @id @default(cuid())
  contact    String
  type       String
  idProvider String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   Provider @relation(fields: [idProvider], references: [id], onDelete: Cascade)

  @@unique([contact, idProvider])
  @@index([idProvider])
}

model Movement {
  id             String         @id @default(cuid())
  type           MovementType
  quantity       Int
  priceAtTime    Decimal        @db.Decimal(10, 2)
  note           String?
  variantId      String
  createdAt      DateTime       @default(now())
  garmentVariant GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model PageConfig {
  id                 Int            @id @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  storeName          String
  description        String?        @db.Text
  slogan             String?
  logo               String?        @db.Text
  favicon            String?        @db.Text
  primaryColor       String?        @default("#000000")
  secondaryColor     String?        @default("#FFFFFF")
  ecommerceEnabled   Boolean        @default(true)
  cartEnabled        Boolean        @default(true)
  checkoutEnabled    Boolean        @default(true)
  featuredLayout     FeaturedLayout @default(GRID)
  phone              String?
  whatsapp           String?
  email              String?
  locationEnabled    Boolean        @default(false)
  address            String?
  city               String?
  province           String?
  country            String?
  postalCode         String?
  mapsUrl            String?        @db.Text
  instagram          String?        @db.Text
  facebook           String?        @db.Text
  tiktok             String?        @db.Text
  x                  String?        @db.Text
  youtube            String?        @db.Text
  linkedin           String?        @db.Text
  currency           String         @default("ARS")
  language           String         @default("es")
  maintenanceMode    Boolean        @default(false)
  metaTitle          String?
  metaDescription    String?        @db.Text
  termsAndConditions String?        @db.Text
  privacyPolicy      String?        @db.Text
  banners            Banner[]
  homegrid           Homegrid?      @relation(fields: [homegridId], references: [id])
  homegridId         String? // Esto crea la clave foránea
}

model Banner {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order        Int
  image        String?    @db.Text
  title        String?
  subtitle     String?
  text         String?    @db.Text
  url          String?    @db.Text
  pageConfigId Int
  pageConfig   PageConfig @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  @@unique([pageConfigId, order])
}

model CustomBoard {
  id             String   @id @default(cuid())
  tipo           String
  largo          String
  ancho          String
  espesor        String
  volumen        String?
  material       String
  cola           String
  killaTipo      String
  killaCount     String
  notas          String?  @db.Text
  deliveryOption String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BoardTypeOption {
  id             String                 @id @default(cuid())
  name           String                 @unique
  svgPath        String?                @db.Text
  active         Boolean                @default(true)
  allowedTails   BoardTailOption[]
  allowedFins    BoardFinOption[]
  allowedConfigs BoardFinConfigOption[]
}

model BoardMaterialOption {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
}

model BoardTailOption {
  id         String            @id @default(cuid())
  name       String            @unique
  svgPath    String?           @db.Text
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardFinOption {
  id         String            @id @default(cuid())
  name       String            @unique
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardDeliveryOption {
  id          String   @id @default(cuid())
  label       String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BoardFinConfigOption {
  id         String            @id @default(cuid())
  name       String            @unique
  count      Int
  active     Boolean           @default(true)
  boardTypes BoardTypeOption[]
}

model BoardFinConfigOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardFinConfigOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardFinConfigOptionToBoardTypeOption_B_index")
  @@map("_BoardFinConfigOptionToBoardTypeOption")
}

model BoardFinOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardFinOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardFinOptionToBoardTypeOption_B_index")
  @@map("_BoardFinOptionToBoardTypeOption")
}

model BoardTailOptionToBoardTypeOption {
  A String
  B String

  @@unique([A, B], map: "_BoardTailOptionToBoardTypeOption_AB_unique")
  @@index([B], map: "_BoardTailOptionToBoardTypeOption_B_index")
  @@map("_BoardTailOptionToBoardTypeOption")
}

model CustomPage {
  id        String          @id @default(cuid())
  slug      String          @unique
  title     String
  subtitle  String?         @db.Text
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  CustomSection[]

  @@map("CustomPages")
}

model CustomSection {
  id       String              @id @default(cuid())
  pageId   String
  type     SectionType
  title    String?
  subtitle String?             @db.Text
  order    Int                 @default(0)
  config   Json?
  page     CustomPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items    CustomSectionItem[]

  @@map("CustomPageSections")
}

model CustomSectionItem {
  id          String        @id @default(cuid())
  sectionId   String
  title       String
  description String?       @db.Text
  image       String?
  icon        String?
  link        String?
  order       Int           @default(0)
  config      Json?
  section     CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("CustomPageItems")
}

model Homegrid {
  id          String       @id @default(cuid())
  title       String
  subtitle    String
  style       Int
  columns     String       @default("md:grid-cols-2")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  grids       Grid[]
  pageConfigs PageConfig[]
}

enum GridLinkType {
  NONE
  CATEGORY
  PRODUCT
  PAGE
  EXTERNAL
}

model Grid {
  id         String       @id @default(cuid())
  title      String
  subtitle   String
  image      String
  linkType   GridLinkType @default(NONE)
  linkValue  String?
  homegridId String
  homegrid   Homegrid     @relation(fields: [homegridId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum user_role {
  USER
  ADMIN
}

enum MovementType {
  IN
  OUT
}

enum SectionType {
  HERO
  TEXT
  CARDS
  FAQ
  TIMELINE
  CTA
  GALLERY
  FEATURES
}

enum FeaturedLayout {
  GRID
  COLLAGE
  MINIMAL
}
