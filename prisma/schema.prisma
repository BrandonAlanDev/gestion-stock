generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  relationMode  = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// --- Autenticación ---

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  telefono      String?
  account       account[]
}

enum user_role {
  USER
  ADMIN
}

// --- Lógica de Negocio ---

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  garments    Garment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Provider {
  id          String    @id @default(cuid())
  name        String    @unique
  contactInfo String?
  active      Boolean   @default(true)
  garments    Garment[] 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 1. Catálogo Base (El producto en general)
model Garment {
  id          String    @id @default(cuid())
  name        String
  price       Decimal   @db.Decimal(10, 2) // Precio base
  description String?
  active      Boolean   @default(true)
  
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  
  supplierId  String?
  supplier    Provider? @relation(fields: [supplierId], references: [id])
  
  // Relación con sus variantes de talle
  variants    GarmentVariant[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([supplierId])
}

// 2. Catálogo de Talles
model Size {
  id          String    @id @default(cuid())
  code        String    @unique // Ej: "S", "M", "L", "42"
  active      Boolean   @default(true)
  
  variants    GarmentVariant[]
}

// 3. Tabla Puente / Inventario Real (La variante física)
model GarmentVariant {
  id          String    @id @default(cuid())
  sku         String?   @unique // El SKU va aquí, es único por talle/color
  stock       Int       @default(0)
  
  garmentId   String
  garment     Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  
  sizeId      String
  size        Size      @relation(fields: [sizeId], references: [id])
  
  // Los movimientos de stock ahora apuntan a la variante específica
  movements   Movement[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([garmentId])
  @@index([sizeId])
}

enum MovementType {
  IN
  OUT
}

// 4. Movimientos (Entradas y Salidas vinculadas a la variante)
model Movement {
  id               String         @id @default(cuid())
  type             MovementType
  quantity         Int
  priceAtTime      Decimal        @db.Decimal(10, 2)
  note             String?
  
  // Relacionado a la variante (talle específico), no al producto general
  variantId        String
  garmentVariant   GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade) 
  
  createdAt        DateTime       @default(now())

  @@index([variantId])
}