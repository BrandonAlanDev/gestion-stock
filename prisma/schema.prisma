generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}



model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?
  telefono      String?
  account       account[]
  pedidos       Pedido[]
  direcciones   DireccionUsuario[]

  @@unique([email])
  @@index([role])
}

model admin_pending_email {
  email      String  @id @db.VarChar(191)
  codigoHash String? @db.VarChar(64)
}

model Category {
  id            String        @id @default(cuid())
  name          String
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  garments      Garment[]

  @@unique([name])
  @@index([active])
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  active     Boolean   @default(true)
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sizeTypeId String?
  category   Category  @relation(fields: [categoryId], references: [id])
  sizeType   SizeType? @relation(fields: [sizeTypeId], references: [id])
  garments   Garment[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([sizeTypeId])
  @@index([active])
}

model Garment {
  id            String           @id @default(cuid())
  name          String
  price         Decimal          @db.Decimal(10, 2)
  description   String?          @db.Text
  active        Boolean          @default(true)
  categoryId    String
  supplierId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cost          Decimal          @db.Decimal(10, 2)
  subCategoryId String?
  maxPrice      Decimal?         @db.Decimal(10, 2)
  etiquetas     Json?
  controlaStock Boolean          @default(true)
  category      Category         @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  supplier      Provider?        @relation(fields: [supplierId], references: [id])
  variants      GarmentVariant[]
  images        GarmentImage[]
  opciones      GarmentOption[]

  @@index([categoryId])
  @@index([categoryId, createdAt])
  @@index([subCategoryId, createdAt])
  @@index([subCategoryId])
  @@index([supplierId])
  @@index([active])
  @@index([active, createdAt])
  @@index([createdAt])
}

model GarmentImage {
  id        String  @id @default(cuid())
  srcImage  String  @db.Text
  publicId  String? @db.Text
  alt       String?
  order     Int     @default(0)
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
}

model GarmentVariant {
  id            String                      @id @default(cuid())
  sku           String?
  stock         Int                         @default(0)
  garmentId     String
  sizeId        String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  colorId       String?
  attributes    Json?
  priceOverride Decimal?                    @db.Decimal(10, 2)
  garment       Garment                     @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size          Size?                       @relation(fields: [sizeId], references: [id])
  color         Color?                      @relation(fields: [colorId], references: [id])
  movements     Movement[]
  optionValues  GarmentVariantOptionValue[]

  @@unique([sku])
  @@index([garmentId])
  @@index([sizeId])
  @@index([colorId])
}

model GarmentOption {
  id        String                @id @default(cuid())
  garmentId String
  name      String
  position  Int                   @default(0)
  garment   Garment               @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  values    GarmentOptionValue[]

  @@unique([garmentId, name])
  @@index([garmentId])
}

model GarmentOptionValue {
  id            String                      @id @default(cuid())
  optionId      String
  value         String
  position      Int                         @default(0)
  option        GarmentOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues GarmentVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
}

model GarmentVariantOptionValue {
  variantId     String
  optionValueId String
  variant       GarmentVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   GarmentOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model SizeType {
  id            String        @id @default(cuid())
  name          String
  active        Boolean       @default(true)
  sizes         Size[]
  subCategories SubCategory[]

  @@unique([name])
  @@index([active])
}

model Size {
  id         String           @id @default(cuid())
  active     Boolean          @default(true)
  order      Int              @default(0)
  sizeTypeId String
  value      String
  sizeType   SizeType         @relation(fields: [sizeTypeId], references: [id])
  variants   GarmentVariant[]

  @@unique([value, sizeTypeId])
  @@index([sizeTypeId])
  @@index([active])
}

model Color {
  id       String           @id @default(cuid())
  name     String
  hex      String?
  active   Boolean          @default(true)
  variants GarmentVariant[]

  @@unique([name])
  @@index([active])
}

model Provider {
  id        String            @id @default(cuid())
  name      String
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  details   String?
  contacts  ContactProvider[]
  garments  Garment[]

  @@unique([name])
  @@index([active])
}

model ContactProvider {
  id         String   @id @default(cuid())
  contact    String
  type       String
  idProvider String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   Provider @relation(fields: [idProvider], references: [id], onDelete: Cascade)

  @@unique([contact, idProvider])
  @@index([idProvider])
  @@index([active])
}

model Movement {
  id             String         @id @default(cuid())
  type           MovementType
  quantity       Int
  priceAtTime    Decimal        @db.Decimal(10, 2)
  note           String?
  variantId      String
  createdAt      DateTime       @default(now())
  garmentVariant GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([type, createdAt])
  @@index([createdAt])
}

model PageConfig {
  id                   Int                       @id @default(autoincrement())
  clave                String                    @unique @default("principal")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  storeName            String
  description          String?                   @db.Text
  slogan               String?
  logo                 String?                   @db.Text
  favicon              String?                   @db.Text
  primaryColor         String?                   @default("#06b6d4")
  secondaryColor       String?                   @default("#FFFFFF")
  bgColor              String?                   @default("#09090b")
  ecommerceEnabled     Boolean                   @default(true)
  cartEnabled          Boolean                   @default(true)
  checkoutEnabled      Boolean                   @default(true)
  phone                String?
  whatsapp             String?
  email                String?
  locationEnabled      Boolean                   @default(false)
  address              String?
  city                 String?
  province             String?
  country              String?
  postalCode           String?
  mapsUrl              String?                   @db.Text
  instagram            String?                   @db.Text
  facebook             String?                   @db.Text
  tiktok               String?                   @db.Text
  x                    String?                   @db.Text
  youtube              String?                   @db.Text
  linkedin             String?                   @db.Text
  currency             String                    @default("ARS")
  language             String                    @default("es")
  maintenanceMode      Boolean                   @default(false)
  metaTitle            String?
  metaDescription      String?                   @db.Text
  termsAndConditions   String?                   @db.Text
  privacyPolicy        String?                   @db.Text
  featuredLayout       PageConfig_featuredLayout @default(GRID)
  homegridId           String?
  footerAboutText      String?                   @db.Text
  footerCopyrightText  String?
  footerShowSobre      Boolean                   @default(true)
  footerShowNavegacion Boolean                   @default(true)
  footerShowContacto   Boolean                   @default(true)
  footerShowUbicacion  Boolean                   @default(true)
  footerShowRedes      Boolean                   @default(true)
  footerShowLegales    Boolean                   @default(true)
  sectionOrder         String                    @default("[\"hero\",\"banner\",\"featured\",\"cards\",\"location\"]")
  fontPrimary          String                    @default("Outfit")
  fontSecondary        String                    @default("Playfair Display")
  borderRadius         String                    @default("redondeado")
  shadowLevel          String                    @default("sutil")
  density              String                    @default("comoda")
  banners              Banner[]
  carousels            Carousel[]
  homegrid             Homegrid?                 @relation(fields: [homegridId], references: [id])

  @@index([homegridId])
}

model Banner {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order        Int
  image        String?    @db.Text
  title        String?
  subtitle     String?
  text         String?    @db.Text
  url          String?    @db.Text
  pageConfigId Int
  pageConfig   PageConfig @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  @@unique([pageConfigId, order])
  @@index([pageConfigId])
}

model CustomPage {
  id        String          @id @default(cuid())
  slug      String
  title     String
  subtitle  String?         @db.Text
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  CustomSection[]

  @@unique([slug])
  @@index([isActive])
  @@map("CustomPages")
}

model CustomSection {
  id       String              @id @default(cuid())
  pageId   String
  type     SectionType
  title    String?
  subtitle String?             @db.Text
  order    Int                 @default(0)
  config   Json?
  page     CustomPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items    CustomSectionItem[]

  @@index([pageId])
  @@map("CustomPageSections")
}

model CustomSectionItem {
  id          String        @id @default(cuid())
  sectionId   String
  title       String
  description String?       @db.Text
  image       String?
  icon        String?
  link        String?
  order       Int           @default(0)
  config      Json?
  section     CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("CustomPageItems")
}

model Homegrid {
  id          String       @id @default(cuid())
  title       String
  subtitle    String
  style       Int
  active           Boolean                        @default(true)
  featuredLayout   PageConfig_featuredLayout      @default(GRID)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  columns          String                         @default("md:grid-cols-2")
  grids            Grid[]
  pageConfigs      PageConfig[]

  @@index([active])
}

model Grid {
  id              String        @id @default(cuid())
  title           String
  subtitle        String
  image           String
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  homegridId      String
  linkType        GridLinkType  @default(NONE)
  linkValue       String?
  subtitleNeon    Boolean       @default(false)
  subtitleDim     Boolean       @default(false)
  linkStyle       LinkStyle     @default(IMAGE)
  buttonVariant   ButtonVariant @default(DEFAULT)
  buttonText      String?
  buttonBgColor   String?
  buttonTextColor String?
  homegrid        Homegrid      @relation(fields: [homegridId], references: [id], onDelete: Cascade)

  @@index([homegridId])
}

enum LinkStyle {
  IMAGE
  BUTTON
}

enum ButtonVariant {
  DEFAULT
  STRAIGHT
  TRANSPARENT
}

enum GridLinkType {
  NONE
  CATEGORY
  PRODUCT
  PAGE
  EXTERNAL
}

enum user_role {
  USER
  ADMIN
}

enum MovementType {
  IN
  OUT
}

enum SectionType {
  HERO
  TEXT
  CARDS
  FAQ
  TIMELINE
  CTA
  GALLERY
  FEATURES
}

enum PageConfig_featuredLayout {
  GRID
  COLLAGE
  MINIMAL
}

enum CarouselType {
  HERO // Carrusel fullscreen estilo Hero, con variante DEFAULT o SHOWCASE (ver settings.heroStyle)
  BANNER // Franja horizontal rotativa (solo debajo del Hero)
  CARDS // Grilla de tarjetas (nueva, paralela a FeaturedSection)
}

model Carousel {
  id           String       @id @default(cuid())
  type         CarouselType
  title        String? // Título de la sección (solo para CARDS/BANNER)
  active       Boolean      @default(true)
  order        Int          @default(0) // Orden global en la home
  pageConfigId Int
  pageConfig   PageConfig   @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  settings Json? // Config específica por tipo (ver abajo)
  slides   CarouselSlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageConfigId, order])
  @@index([active])
  @@index([pageConfigId])
}

model CarouselSlide {
  id         String   @id @default(cuid())
  carouselId String
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)

  order       Int
  image       String? @db.Text
  publicId    String? @db.Text
  title       String?
  subtitle    String?
  description String? @db.Text
  ctaText     String? // Texto del botón (NUEVO vs Banner actual)
  url         String? @db.Text

  // Config por slide (para Hero: layout "standard" | "split" | "minimal")
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carouselId, order])
  @@index([carouselId])
}

model CuentaMercadoPago {
  id           String    @id @default(cuid())
  clave        String    @unique @default("principal")
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  publicKey    String?
  mpUserId     String?
  scope        String?   @db.Text
  liveMode     Boolean   @default(false)
  conectado    Boolean   @default(true)
  expiraEn     DateTime?
  nombreNegocio String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

}

model Pedido {
  id             String           @id @default(cuid())
  numero         Int?             @unique
  userId         String
  estado         PedidoEstado     @default(PENDIENTE)
  estadoPago     PedidoEstadoPago @default(PENDIENTE)
  estadoEnvio    PedidoEstadoEnvio @default(PENDIENTE)
  metodoEntrega  MetodoEntrega    @default(DOMICILIO)
  stockReservado Boolean          @default(false)
  reservaExpiraEn DateTime?
  subtotal       Decimal          @default(0) @db.Decimal(10, 2)
  descuento      Decimal          @default(0) @db.Decimal(10, 2)
  costoEnvio     Decimal          @default(0) @db.Decimal(10, 2)
  total          Decimal          @db.Decimal(10, 2)
  moneda         String           @default("ARS")
  nombreCliente  String?
  apellidoCliente String?
  dniCliente     String?
  telefonoCliente String?
  emailCliente   String?
  mpPreferenceId String?
  mpPaymentId    String?
  metodoPago     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           user             @relation(fields: [userId], references: [id])
  items          PedidoItem[]
  payments       Payment[]
  envio          PedidoEnvio?
  eventos        PedidoEvento[]

  @@index([createdAt])
  @@index([estado, reservaExpiraEn])
  @@index([userId])
  @@index([userId, createdAt])
}

model NumeroPedido {
  id Int @id @default(autoincrement())
}

model PedidoItem {
  id             String   @id @default(cuid())
  pedidoId       String
  stockReservado Boolean  @default(false)
  garmentId      String
  variantId      String
  nombre         String
  varianteNombre String?
  imagen         String?  @db.Text
  precioUnitario Decimal  @db.Decimal(10, 2)
  cantidad       Int
  subtotal       Decimal  @db.Decimal(10, 2)
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

model PedidoEnvio {
  id               String       @id @default(cuid())
  pedidoId         String       @unique
  metodoEntrega    MetodoEntrega @default(DOMICILIO)
  destinatario     String?
  telefono         String?
  calle            String?
  numero           String?
  piso             String?
  departamento     String?
  codigoPostal     String?
  localidad        String?
  provincia        String?
  pais             String       @default("AR")
  referencias      String?      @db.Text
  transportista    String?
  transportistaId  String?
  trackingNumero   String?
  trackingUrl      String?      @db.Text
  fechaDespacho    DateTime?
  fechaEstimada    DateTime?
  fechaEntrega     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  pedido           Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  transportistaRel Transportista? @relation(fields: [transportistaId], references: [id])

  @@index([transportistaId])
}

model DireccionUsuario {
  id           String   @id @default(cuid())
  userId       String
  alias        String?
  destinatario String?
  telefono     String?
  calle        String
  numero       String
  piso         String?
  departamento String?
  codigoPostal String
  localidad    String
  provincia    String
  pais         String   @default("AR")
  referencias  String?  @db.Text
  esPrincipal  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, esPrincipal])
}

model Transportista {
  id           String        @id @default(cuid())
  nombre       String
  slug         String        @unique
  plantillaUrl String?       @db.Text
  requiereUrl  Boolean       @default(false)
  activo       Boolean       @default(true)
  orden        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pedidoEnvios PedidoEnvio[]

  @@index([activo, orden])
}

model PedidoEvento {
  id             String           @id @default(cuid())
  pedidoId       String
  tipo           PedidoEventoTipo
  descripcion    String
  estadoAnterior String?
  estadoNuevo    String?
  usuarioId      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  pedido         Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, createdAt])
}

enum PedidoEstado {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  LISTO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PedidoEstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
  EN_ACREDITACION
  REEMBOLSADO
}

enum PedidoEstadoEnvio {
  PENDIENTE
  PREPARANDO
  DESPACHADO
  ENTREGADO
}

enum MetodoEntrega {
  DOMICILIO
  RETIRO_TIENDA
  PUNTO_RETIRO
}

enum PedidoEventoTipo {
  CREACION
  PAGO_APROBADO
  PAGO_RECHAZADO
  PAGO_EN_ACREDITACION
  CANCELADO
  REEMBOLSADO
  CAMBIO_ESTADO
  CAMBIO_ENVIO
  NOTA
}

model MetodoPago {
  id        String   @id @default(cuid())
  metodo    String // Identificador: "mercadopago" | "transferencia" | ...
  activo    Boolean  @default(false)
  config    Json? // Configuración propia del método (ej. instrucciones de transferencia)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metodo])
  @@index([activo])
}

model Payment {
  id         String           @id @default(cuid())
  pedidoId   String
  proveedor  String // "mercadopago" | "transferencia" | ...
  metodo     String
  externalId String? // ID externo en la pasarela (mpPaymentId, etc.)
  estado     PedidoEstadoPago @default(PENDIENTE)
  monto      Decimal          @db.Decimal(10, 2)
  moneda     String           @default("ARS")
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  pedido     Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([proveedor])
  @@unique([proveedor, externalId])
}
