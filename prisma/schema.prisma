generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql" 
  relationMode = "prisma"
}

// --- AUTENTICACIÓN ---

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?
  telefono      String?
  account       account[]
}

enum user_role {
  USER
  ADMIN
}

// --- PRODUCTOS Y CATEGORÍAS ---

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  subCategories SubCategory[]
  garments      Garment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id          String    @id @default(cuid())
  name        String
  active      Boolean   @default(true)
  
  // Relación con Categoría
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  
  // NUEVO: La curva de talles ahora vive acá 
  sizeTypeId  String?
  sizeType    SizeType? @relation(fields: [sizeTypeId], references: [id])
  
  garments    Garment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([sizeTypeId]) // Añadido índice para optimizar búsquedas por talle
}

model Garment {
  id            String           @id @default(cuid())
  name          String
  description   String?          @db.Text
  price         Decimal          @db.Decimal(10, 2)
  cost          Decimal          @db.Decimal(10, 2)
  active        Boolean          @default(true)
  
  // Relaciones
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory?      @relation(fields: [subCategoryId], references: [id])
  supplierId    String?
  supplier      Provider?        @relation(fields: [supplierId], references: [id])
  
  variants      GarmentVariant[]
  images        GarmentImage[]   // Relación para las 4 fotos

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([supplierId])
}

// Modelo para manejar múltiples fotos
model GarmentImage {
  id        String   @id @default(cuid())
  srcImage  String   @db.Text
  alt       String?
  order     Int      @default(0) // Para decidir cuál es la principal (0)
  garmentId String
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
}

// --- STOCK Y VARIANTES ---

model GarmentVariant {
  id        String     @id @default(cuid())
  sku       String?    @unique
  stock     Int        @default(0)
  garmentId String
  sizeId    String?
  colorId   String?
  garment   Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size      Size?      @relation(fields: [sizeId], references: [id])
  color     Color?     @relation(fields: [colorId], references: [id])
  attributes Json?

  movements Movement[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([garmentId, sizeId, colorId])
  @@index([garmentId])
  @@index([sizeId])
  @@index([colorId])
}

model SizeType {
  id         String     @id @default(cuid())
  name       String     @unique
  active     Boolean    @default(true)
  sizes      Size[]
  subCategories SubCategory[]
}

model Size {
  id         String           @id @default(cuid())
  value      String
  order      Int              @default(0)
  active     Boolean          @default(true)
  sizeTypeId String
  sizeType   SizeType         @relation(fields: [sizeTypeId], references: [id])
  variants   GarmentVariant[]

  @@unique([value, sizeTypeId])
  @@index([sizeTypeId])
}

model Color {
  id       String           @id @default(cuid())
  name     String           @unique
  hex      String?
  active   Boolean          @default(true)
  variants GarmentVariant[]
}

// --- PROVEEDORES Y MOVIMIENTOS ---

model Provider {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  details   String?
  contacts  ContactProvider[]
  garments  Garment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ContactProvider {
  id         String   @id @default(cuid())
  contact    String
  type       String
  idProvider String
  active     Boolean  @default(true)
  provider   Provider @relation(fields: [idProvider], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contact, idProvider])
  @@index([idProvider])
}

model Movement {
  id             String         @id @default(cuid())
  type           MovementType
  quantity       Int
  priceAtTime    Decimal        @db.Decimal(10, 2)
  note           String?
  variantId      String
  garmentVariant GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([variantId])
}

model PageConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =========================
  // INFORMACIÓN DEL NEGOCIO
  // =========================
  storeName   String
  description String? @db.Text
  slogan      String?

  // =========================
  // BRANDING
  // =========================
  logo        String? @db.Text
  favicon     String? @db.Text
  banner      String? @db.Text

  primaryColor   String? @default("#000000")
  secondaryColor String? @default("#FFFFFF")

  // =========================
  // ECOMMERCE
  // =========================
  ecommerceEnabled Boolean @default(true)
  cartEnabled      Boolean @default(true)
  checkoutEnabled  Boolean @default(true)

  // =========================
  // CONTACTO
  // =========================
  phone      String?
  whatsapp   String?
  email      String?

  // =========================
  // UBICACIÓN
  // =========================
  locationEnabled Boolean @default(false)

  address  String?
  city     String?
  province String?
  country  String?

  postalCode String?

  mapsUrl String? @db.Text

  // =========================
  // REDES SOCIALES
  // =========================
  instagram String? @db.Text
  facebook  String? @db.Text
  tiktok    String? @db.Text
  x         String? @db.Text
  youtube   String? @db.Text
  linkedin  String? @db.Text

  // =========================
  // CONFIGURACIONES GENERALES
  // =========================
  currency String @default("ARS")
  language String @default("es")

  maintenanceMode Boolean @default(false)

  // =========================
  // SEO
  // =========================
  metaTitle       String?
  metaDescription String? @db.Text

  // =========================
  // OPCIONALES FUTUROS
  // =========================
  termsAndConditions String? @db.Text
  privacyPolicy      String? @db.Text
}

enum MovementType {
  IN
  OUT
}

