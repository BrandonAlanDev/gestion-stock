generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  relationMode  = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// --- Autenticación ---

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  password      String?
  role          user_role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  telefono      String?
  account       account[]
}

enum user_role {
  USER
  ADMIN
}

// --- Lógica de Negocio ---

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)

  sizeTypeId  String?
  sizeType    SizeType? @relation(fields: [sizeTypeId], references: [id])

  garments    Garment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([sizeTypeId])
}

model Provider {
  id          String    @id @default(cuid())
  name        String    @unique
  details     String?
  contacts ContactProvider[]
  active      Boolean   @default(true)
  garments    Garment[] 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactProvider {
  id          String   @id @default(cuid())
  contact     String
  type        String
  idProvider  String
  provider    Provider @relation(fields: [idProvider], references: [id], onDelete: Cascade)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contact, idProvider], name: "contact_provider_unique")
}

// 1. Catálogo Base (El producto en general)
model Garment {
  id          String    @id @default(cuid())
  name        String
  price       Decimal   @db.Decimal(10, 2) // Precio base
  cost       Decimal   @db.Decimal(10, 2) // Precio de costo
  description String?
  active      Boolean   @default(true)
  
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  
  supplierId  String?
  supplier    Provider? @relation(fields: [supplierId], references: [id])
  
  // Relación con sus variantes de talle
  variants    GarmentVariant[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([supplierId])
}

// 2. Catálogo de Talles CAMBIOS!
model SizeType {
  id        String   @id @default(cuid())
  name      String   @unique // "Ropa (S-M-L)", "Calzado EU", etc.
  active    Boolean  @default(true)

  sizes     Size[]
  categories Category[] // Las categorías que usan este tipo de talle
}

model Size {
  id          String   @id @default(cuid())
  value       String   // "S", "M", "40", "40.5"
  order       Int      // para ordenar correctamente
  sizeTypeId  String
  sizeType    SizeType @relation(fields: [sizeTypeId], references: [id])

  active      Boolean  @default(true)
  variants    GarmentVariant[]
  @@unique([value, sizeTypeId]) // Evita duplicar "S" en el mismo tipo de talle
}

// 3. Tabla Puente / Inventario Real (La variante física)
model GarmentVariant {
  id          String    @id @default(cuid())
  sku         String?   @unique
  stock       Int       @default(0)

  garmentId   String
  sizeId      String

  garment     Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  size        Size      @relation(fields: [sizeId], references: [id])

  colorId   String?
  color     Color? @relation(fields: [colorId], references: [id])

  movements   Movement[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt



  @@unique([garmentId, sizeId, colorId])
}

enum MovementType {
  IN
  OUT
}

// 4. Movimientos (Entradas y Salidas vinculadas a la variante)
model Movement {
  id               String         @id @default(cuid())
  type             MovementType
  quantity         Int
  priceAtTime      Decimal        @db.Decimal(10, 2)
  note             String?
  
  // Relacionado a la variante (talle específico), no al producto general
  variantId        String
  garmentVariant   GarmentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade) 
  
  createdAt        DateTime       @default(now())

  @@index([variantId])
}

model Color {
  id      String   @id @default(cuid())
  name    String   @unique
  hex     String?  // opcional por si guardamos el color para mostrar en la UI
  active  Boolean  @default(true)

  variants GarmentVariant[]
}