# URL para los comandos de Prisma sobre una base tenant elegida manualmente.
# Nunca es un fallback de runtime ni se debe apuntar a una base productiva por accidente.
DATABASE_URL="mysql://usuario:clave@127.0.0.1:3306/gestion_stock"

# Autenticación
AUTH_SECRET="reemplazar-por-un-secreto-seguro"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Logabyte Core: credencial global del producto gestion-stock para producción.
# La URL debe ser HTTPS y apuntar a la raíz del servicio, sin /api/internal/v1.
LOGABYTE_CORE_URL=""
LOGABYTE_CORE_PRODUCTO="gestion-stock"
LOGABYTE_CORE_SERVICE_TOKEN=""

# Registro local cifrado para desarrollo; no habilita tenants dinámicos en producción.
TENANT_REGISTRY_FILE=".local/tenant-registry.enc.json"
TENANT_REGISTRY_ENCRYPTION_KEY=""
TENANT_PRISMA_MAX_CLIENTS="10"
TENANT_PRISMA_CONNECTION_LIMIT="2"
TENANT_PRISMA_IDLE_TTL_MS="60000"

# Mercado Pago (Checkout Pro + OAuth)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_AUTH_BASE_URL="https://auth.mercadopago.com.ar"
MP_WEBHOOK_SECRET=""
# URI HTTPS fija registrada en Mercado Pago; en producción es obligatoria.
# El callback central valida el tenant y devuelve el navegador a su dominio.
MP_REDIRECT_URI=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Secreto global para autenticar el scheduler de expiración de pedidos.
CRON_SECRET=""
