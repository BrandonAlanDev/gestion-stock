# Registro central de dominios y conexiones (solo servidor).
LOGABYTE_CORE_URL="https://core.ejemplo.com/"
LOGABYTE_CORE_SERVICE_TOKEN="lbcore_reemplazar.reemplazar_por_un_token_de_servicio_valido"
LOGABYTE_CORE_PRODUCTO="gestion-stock"
# Opcional en desarrollo local si Core usa una base remota lenta; producción conserva 3 s/5 s.
LOGABYTE_CORE_TIMEOUT_MS=""
# Solo en `npm run dev`: dominio ya registrado en Core que se usará al entrar por localhost.
TENANT_TEST_HOSTNAME=""

# Destino explícito para Prisma CLI; la aplicación no usa esta variable.
DATABASE_URL="mysql://usuario:clave@127.0.0.1:3306/gestion_stock"

# Límite de pools Prisma por proceso.
TENANT_PRISMA_MAX_CLIENTS="10"
TENANT_PRISMA_CONNECTION_LIMIT="2"
TENANT_PRISMA_IDLE_TTL_MS="60000"

# Autenticación
AUTH_SECRET="reemplazar-por-un-secreto-seguro"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago (Checkout Pro y OAuth)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_AUTH_BASE_URL="https://auth.mercadopago.com.ar"
MP_WEBHOOK_SECRET=""
MP_REDIRECT_URI=""

# Aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""

# Solo para npm run crear:admin.
ADMIN_TENANT_ID=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
