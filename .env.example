# Base de datos principal multi-tenant
DATABASE_URL="mysql://usuario:clave@127.0.0.1:3306/gestion_stock"
DATABASE_HOST="127.0.0.1"
DATABASE_USER="usuario"
DATABASE_PASSWORD="clave"
DATABASE_NAME="gestion_stock"

# Autenticación
AUTH_SECRET="reemplazar-por-un-secreto-seguro"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resolución de tenants en producción
DOMINIO_PRINCIPAL="localhost"

# Migración de una base antigua hacia un tenant nuevo
# La cuenta del origen debería tener únicamente permiso SELECT.
DATABASE_URL_ORIGEN=""
TENANT_NOMBRE=""
TENANT_SLUG=""
TENANT_DOMINIO=""

# Mercado Pago (Checkout Pro + OAuth)
# Aplicación creada en: mercadopago.com.ar/developers/panel/app
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Base de autorización OAuth por país (default Argentina)
MP_AUTH_BASE_URL="https://auth.mercadopago.com.ar"
# Secret para validar la firma (X-Signature) de los webhooks de Mercado Pago.
# Se genera en el panel de la app. Sin él, el webhook falla cerrado en producción.
MP_WEBHOOK_SECRET=""
# URL de redirección OAuth. Si se omite, se deriva del host (o de NEXT_PUBLIC_APP_URL).
# En desarrollo: http://localhost:3000/api/mercadopago/oauth/callback
MP_REDIRECT_URI=""

# URL base de la aplicación
# Desarrollo: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
