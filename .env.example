# Registro central de dominios y conexiones (solo servidor).
# Configurá ambas variables. La cuenta SQL
# necesita SELECT en el catálogo Core e INSERT en registros_auditoria.
# En producción la URL debe usar ?sslaccept=strict.
LOGABYTE_CORE_DATABASE_URL=""
CIFRADO_CONEXIONES_SECRETO=""
# Solo en `npm run dev`: dominio ya registrado en Core que se usará al entrar por localhost.
TENANT_TEST_HOSTNAME=""

# Límite de pools Prisma por proceso.
TENANT_PRISMA_MAX_CLIENTS="10"
TENANT_PRISMA_CONNECTION_LIMIT="2"
TENANT_PRISMA_IDLE_TTL_MS="60000"
# Solo si todas las bases de tenant del proceso son TiDB; se aplica por sesión en cada conexión.
TENANT_TIDB_TXN_MODE=""

# Mediciones temporales de duración para checkout y operaciones de inventario.
INVENTARIO_MEDIR_TRANSACCIONES="0"

# Prueba de integración con TiDB: apuntar exclusivamente a una base descartable.
INVENTARIO_TEST_TENANT_ID=""
INVENTARIO_TEST_DATABASE_NAME=""

# Autenticación
AUTH_SECRET="reemplazar-por-un-secreto-seguro"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago (Checkout Pro y OAuth)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_AUTH_BASE_URL="https://auth.mercadopago.com.ar"
MP_WEBHOOK_SECRET=""
MP_REDIRECT_URI=""

# Aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""
